{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "opencabinet": {
      "type": "streamable-http",
      "url": "https://opencabinetai.com/api/sales-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://opencabinetai.com/api/sales-mcp",
            "baseScopes": [
              "sales:read"
            ],
            "defaultScopes": [
              "sales:read",
              "sales:write",
              "design:read",
              "design:write"
            ]
          }
        }
      }
    }
  }
}
